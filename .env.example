DB_URL=jdbc:mysql://localhost:3306/payment_stripe_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# Stripe (Test / Live)
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# CFDI Express (Facturación CFDI 4.0)
CFDI_EXPRESS_API_KEY=sk_test_your_cfdi_express_api_key
CFDI_EXPRESS_MERCHANT_ID=your_cfdi_express_merchant_id
EMITTER_ZIP_CODE=42501

# Mailtrap Java SDK (Email Sending API o Sandbox)
MAILTRAP_TOKEN=your_mailtrap_api_token
MAILTRAP_SANDBOX=false
MAILTRAP_INBOX_ID=
MAILTRAP_FROM_EMAIL=hello@demomailtrap.com
MAILTRAP_FROM_NAME=Pasarela de Pagos
MAILTRAP_OVERRIDE_TO=

# Seguridad JWT (mínimo 32 caracteres recomendado)
JWT_SECRET=change_this_to_a_secure_random_secret_at_least_32_chars

# URL del Frontend (usada en CORS y return_url de Stripe Checkout)
FRONTEND_URL=http://localhost:4200
